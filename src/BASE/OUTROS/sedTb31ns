/*      Esse método além de mandar o menu, ele já vai pegar a escolha do jogador
    e puxar os métodos das classe fazendo todo o trabalho */

public void OqueFazerComItem (String item, INVENTARIO inv, Jogador jogador) throws InterruptedException {
    Scanner scN = new Scanner (System.in);
    EfeitoItem Efec = new EfeitoItem();
    boolean finalizador = false;

do {
    System.out.println("\n|=================================|");
    System.out.println("|Oque você quer fazer com " +item+ "|");
    System.out.println("|=================================|");
    System.out.println("1. Guardar");
    System.out.println("2. Usar");
    System.out.println("3. Deixar");
        int Escolha = scN.nextInt();
        
    switch (Escolha) {
        case 1 -> { // Guardar: O item vai ser guardado dentro da mochila
            inv.AdicionarItem(item);
            finalizador = true;
            break;
        }
        case 2 -> { // Usar: Dependedo o Item vai ter efeito Diferente
            // Como eu ainda não fiz o sistema de combate, esse opção só está existindo
            Efec.Efeito(item, jogador);
            finalizador = true;
            break;
        }
        case 3 -> { // Deixar: Esse opção só vai exbir uma Mensagem
            System.out.println("\nVocê decide deixar " +item+ " para trás");
            finalizador = true;
            break;
        }
        default -> {
            System.out.println("Opção invalida");
            System.out.println("Por favor escolha uma Opção valida");
            finalizador = true;
            Thread.sleep(500);
            break;
        }
    }
    Thread.sleep(1500);
    System.out.println("\n\n\n\n\n\n\n\n\n\n\n\n\n");
} while (finalizador != true);   
    
}
